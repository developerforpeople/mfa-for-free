# ---------------------------------------------------------------------------
# NLR Identity - demo website environment
#
# Copy this file to `.env.local` and fill in your own values:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. NEVER commit real credentials.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle. That
# prefix is a loaded gun: anything you put here ships to every visitor and can
# be read with devtools. Firebase web config is designed to be public - it
# identifies your project, it does not authorise access - but a service account
# key, an admin credential, or an API secret must NEVER appear in this file.
# Those belong in server-side code only.
# ---------------------------------------------------------------------------

# --- Firebase ---------------------------------------------------------------
# From the Firebase console: Project settings > General > Your apps > Web app.
# The landing page renders fine with these left blank - the app detects the
# missing config and shows a setup notice instead of crashing. Registration,
# sign-in, and MFA enrollment DO need a real project.
#
# In the Firebase console you must also enable:
#   Authentication > Sign-in method > Email/Password
#   Firestore Database  (start in production mode, then deploy firestore.rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Only needed if you add Firebase Analytics, which this project does
# not - an educational auth demo has no reason to track its visitors.
VITE_FIREBASE_MEASUREMENT_ID=

# --- Local development -----------------------------------------------------
# Point the SDK at the Firebase Emulator Suite instead of a live project.
# Strongly recommended while developing: no credentials, no billing, no risk of
# writing test data into production.
VITE_FIREBASE_USE_EMULATOR=false
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# --- Site metadata ---------------------------------------------------------
VITE_GITHUB_REPO_URL=https://github.com/developerforpeople/mfa-for-free
VITE_DOCS_URL=https://github.com/developerforpeople/mfa-for-free/tree/main/docs
