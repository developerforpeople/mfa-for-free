coverage/
.nyc_output/

# Companion Flutter authenticator - kept locally, not published.
# The website works with any TOTP app (Google Authenticator, Microsoft
# Authenticator, 1Password), because the enrollment QR is a standard
# otpauth:// URI.
authenticator-app/
# Firebase CLI project selection - copy .firebaserc.example to .firebaserc
.firebaserc

# Platform config for the Flutter app. Not a high-value secret (these are
# client identifiers, like the web config), but there is no reason to publish
# one project's identifiers in a repo other people fork.
authenticator-app/android/app/google-services.json
authenticator-app/ios/Runner/GoogleService-Info.plist
authenticator-app/lib/firebase_options.dart
